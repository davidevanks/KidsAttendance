@model KidsAttendance.Web.ViewModels.ChildCreateViewModel
@{
    var guardians = ViewBag.Guardians as IReadOnlyList<KidsAttendance.Infrastructure.Persistence.Entities.Guardian> ?? new List<KidsAttendance.Infrastructure.Persistence.Entities.Guardian>();
}
<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control form-control-lg" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="row g-2">
                <div class="col-6">
                    <label asp-for="BirthDate" class="form-label"></label>
                    <input asp-for="BirthDate" type="date" class="form-control form-control-lg" />
                    <span asp-validation-for="BirthDate" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label asp-for="Age" class="form-label"></label>
                    <input asp-for="Age" type="number" min="0" max="20" step="1" class="form-control form-control-lg" />
                    <span asp-validation-for="Age" class="text-danger small"></span>
                </div>
            </div>
            <div class="mt-3">
                <label asp-for="CurrentClassGroupId" class="form-label"></label>
                <select asp-for="CurrentClassGroupId" class="form-select form-select-lg" asp-items="ViewBag.ClassGroups"></select>
                <span asp-validation-for="CurrentClassGroupId" class="text-danger small"></span>
            </div>
            <div class="mt-3">
                <label class="form-label">Padres asociados</label>
                <select asp-for="SelectedGuardianIds" class="form-select js-guardian-select" multiple size="8" data-placeholder="Buscar padre por nombre o celular">
                    @foreach (var guardian in guardians)
                    {
                        <option value="@guardian.Id">@guardian.FullName - @guardian.PhoneNumber</option>
                    }
                </select>
                <div class="form-text">Podés seleccionar varios padres.</div>
            </div>
            <div class="form-check mt-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary btn-lg">Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>
