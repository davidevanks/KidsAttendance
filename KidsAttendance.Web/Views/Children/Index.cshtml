@model IReadOnlyList<KidsAttendance.Web.ViewModels.ChildIndexViewModel>
@{
    ViewData["Title"] = "Niños";
    var groups = ViewBag.Groups as Dictionary<int, string> ?? new();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Niños</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo niño</a>
</div>
@if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success">@successMessage</div> }
<div class="table-responsive">
    <table class="js-datatable table table-striped align-middle">
        <thead><tr><th data-priority="1">Nombre</th><th data-priority="2">Padres</th>@if (!User.IsInRole(ApplicationRoles.Teacher)) { <th data-priority="2">Celular</th> }<th data-priority="4">Edad</th><th data-priority="3">Grupo</th><th data-priority="4">Estado</th><th data-priority="1" class="text-end">Editar</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.GuardiansText</td>
                @if (!User.IsInRole(ApplicationRoles.Teacher)) { <td>@item.GuardianPhoneNumbersText</td> }
                <td>@(item.Age?.ToString() ?? "-")</td>
                <td>@groups.GetValueOrDefault(item.CurrentClassGroupId, $"Grupo #{item.CurrentClassGroupId}")</td>
                <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Activo" : "Inactivo")</span></td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Editar</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
