@model KidsAttendance.Web.ViewModels.AttendanceReportFilterViewModel
@{
    ViewData["Title"] = "Reporte de Asistencia";
    var result = ViewBag.Result as IReadOnlyList<KidsAttendance.Web.ViewModels.AttendanceReportResultViewModel> ?? new List<KidsAttendance.Web.ViewModels.AttendanceReportResultViewModel>();
}
<h1 class="h4 mb-3">Reporte de Asistencia por Día</h1>
<form method="get" class="row g-2 mb-3">
    <div class="col-8 col-md-4">
        <input asp-for="Date" type="date" class="form-control form-control-lg" />
    </div>
    <div class="col-4 col-md-2">
        <button class="btn btn-outline-primary btn-lg w-100">Consultar</button>
    </div>
    <div class="col-12 col-md-3">
        <a asp-action="DownloadAttendanceExcel" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" class="btn btn-success btn-lg w-100">Descargar Excel</a>
    </div>
</form>
<div class="card shadow-sm">
    <div class="card-body">
        @foreach (var item in result)
        {
            <p class="mb-1"><strong>@item.GroupName:</strong> @item.Count niños</p>
        }
        <hr />
        <p class="mb-0"><strong>Total general:</strong> @result.Sum(x => x.Count)</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js" asp-append-version="true"></script>
}
