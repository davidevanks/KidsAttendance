@model KidsAttendance.Web.ViewModels.ClassGroupViewModel
@{
    ViewData["Title"] = "Nuevo Grupo";
}

<h1 class="h4 mb-3">Nuevo Grupo</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control form-control-lg" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="row g-3">
                <div class="col-6">
                    <label asp-for="MinAge" class="form-label"></label>
                    <input asp-for="MinAge" type="number" min="0" max="99" step="1" class="form-control form-control-lg" />
                    <span asp-validation-for="MinAge" class="text-danger small"></span>
                </div>
                <div class="col-6">
                    <label asp-for="MaxAge" class="form-label"></label>
                    <input asp-for="MaxAge" type="number" min="0" max="99" step="1" class="form-control form-control-lg" />
                    <span asp-validation-for="MaxAge" class="text-danger small"></span>
                </div>
            </div>
            <div class="form-check mt-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary btn-lg">Guardar</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
