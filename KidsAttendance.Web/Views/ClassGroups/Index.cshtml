@model IReadOnlyList<KidsAttendance.Web.ViewModels.ClassGroupViewModel>
@{
    ViewData["Title"] = "Grupos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Grupos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo grupo</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="table-responsive">
    <table class="js-datatable table table-striped align-middle">
        <thead>
            <tr>
                <th data-priority="1">Nombre</th>
                <th data-priority="5">Edad minima</th>
                <th data-priority="5">Edad maxima</th>
                <th data-priority="2">Maestros</th>
                <th data-priority="4">Estado</th>
                <th data-priority="1" class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.MinAge</td>
                <td>@item.MaxAge</td>
                <td>@item.AssignedTeachersText</td>
                <td>
                    <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Activo" : "Inactivo")</span>
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                    <form asp-action="ToggleActive" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="isActive" value="@(!item.IsActive)" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">@(item.IsActive ? "Desactivar" : "Activar")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
