@model KidsAttendance.Web.ViewModels.UserCreateViewModel
@{
    ViewData["Title"] = "Nuevo Usuario";
}
<h1 class="h4 mb-3">Nuevo Usuario</h1>
<partial name="_UserForm" model="Model" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            var roleSelect = $("#Role");
            var asistenciaGlobalCheck = $(".ka-asistencia-global-check");
            function toggleAsistenciaGlobal() {
                asistenciaGlobalCheck.toggle(roleSelect.val() === "@ApplicationRoles.Teacher");
            }
            roleSelect.on("change", toggleAsistenciaGlobal);
            toggleAsistenciaGlobal();
        });
    </script>
}
