@model IReadOnlyList<KidsAttendance.Infrastructure.Persistence.Entities.AppUser>
@{
    ViewData["Title"] = "Usuarios";
    var userRoles = ViewBag.UserRoles as IReadOnlyDictionary<string, string> ?? new Dictionary<string, string>();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Usuarios</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo usuario</a>
</div>
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Nombre</th><th>Rol</th><th>Correo</th><th>Celular</th><th>Estado</th><th class="text-end">Acciones</th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@(userRoles.GetValueOrDefault(item.Id) ?? "-")</td>
                <td>@item.Email</td>
                <td>@(string.IsNullOrWhiteSpace(item.PhoneNumber) ? "-" : item.PhoneNumber)</td>
                <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Activo" : "Inactivo")</span></td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Editar</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
