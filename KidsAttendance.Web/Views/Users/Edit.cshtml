@model KidsAttendance.Web.ViewModels.UserCreateViewModel
@{
    ViewData["Title"] = "Editar Usuario";
}
<h1 class="h4 mb-3">Editar Usuario</h1>
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}
<partial name="_UserForm" model="Model" />

<div class="card shadow-sm mt-3">
    <div class="card-body">
        <h2 class="h6">Reset de contraseña</h2>
        <form asp-action="ResetPassword" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-12 col-md-8">
                <input type="password" name="newPassword" class="form-control form-control-lg" placeholder="Nueva contraseña temporal" required />
            </div>
            <div class="col-12 col-md-4">
                <button type="submit" class="btn btn-outline-danger btn-lg w-100">Reset Password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
