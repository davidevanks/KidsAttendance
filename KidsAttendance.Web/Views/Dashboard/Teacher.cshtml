@{
    ViewData["Title"] = "Dashboard Maestro";
}

<div class="container py-4">
    <h1 class="h4 mb-3">Panel Maestro</h1>
    <p class="ka-muted mb-3">Flujos rápidos para uso desde celular.</p>
    <div class="d-grid gap-2">
        <a asp-controller="Attendance" asp-action="CheckIn" class="btn btn-primary btn-lg">Registrar Entrada</a>
        <a asp-controller="Attendance" asp-action="CheckOut" class="btn btn-outline-primary btn-lg">Registrar Salida</a>
        <a asp-controller="Attendance" asp-action="Today" class="btn btn-outline-secondary btn-lg">Asistencia de mi Grupo</a>
        <a asp-controller="Guardians" asp-action="Index" class="btn btn-outline-secondary btn-lg">Buscar Padre</a>
        <a asp-controller="Children" asp-action="Index" class="btn btn-outline-secondary btn-lg">Niños</a>
    </div>
</div>
