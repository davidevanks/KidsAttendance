@{
    ViewData["Title"] = "Dashboard Maestro";
    var hasAsistenciaGlobal = (ViewBag.HasAsistenciaGlobal as bool?) == true;
}

<div class="container py-4">
    <h1 class="h4 mb-3">Panel Maestro</h1>
  
    @if (hasAsistenciaGlobal)
    {
        <h2 class="h5 mt-4 mb-3">Asistencia Global</h2>
        <div class="d-grid gap-2 mb-4">
            <a asp-controller="Attendance" asp-action="GlobalCheckIn" class="btn btn-success btn-lg">Registrar Entrada Global</a>
            <a asp-controller="Attendance" asp-action="GlobalCheckOut" class="btn btn-outline-success btn-lg">Registrar Salida Global</a>
            <a asp-controller="Attendance" asp-action="GlobalToday" class="btn btn-outline-success btn-lg">Asistencia Global</a>
            <a asp-controller="Children" asp-action="Index" class="btn btn-outline-success btn-lg">Niños y Familias</a>
        </div>
        <h2 class="h5 mt-3 mb-3">Mi Grupo</h2>
    }
    <div class="d-grid gap-2">
        <a asp-controller="Attendance" asp-action="CheckIn" class="btn btn-primary btn-lg">Registrar Entrada</a>
        <a asp-controller="Attendance" asp-action="CheckOut" class="btn btn-outline-primary btn-lg">Registrar Salida</a>
        <a asp-controller="Attendance" asp-action="Today" class="btn btn-outline-secondary btn-lg">Asistencia de mi Grupo</a>
        <a asp-controller="Reports" asp-action="MonthlyGroupAttendance" class="btn btn-outline-secondary btn-lg">Reporte mensual de mi Grupo</a>
        @if (!hasAsistenciaGlobal)
        {
            <a asp-controller="Children" asp-action="Index" class="btn btn-outline-secondary btn-lg">Niños y Familias</a>
        }
        else
        {
            <a asp-controller="Children" asp-action="Index" asp-route-myGroupOnly="true" class="btn btn-outline-secondary btn-lg">Niños y Familias</a>
        }
    </div>
</div>
