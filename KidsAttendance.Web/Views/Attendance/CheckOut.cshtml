@model KidsAttendance.Web.ViewModels.CheckOutViewModel
@{
    ViewData["Title"] = "Registrar Salida";
    var activeRows = ViewBag.ActiveRows as IReadOnlyList<KidsAttendance.Web.Controllers.AttendanceController.CheckOutSearchRow>
        ?? new List<KidsAttendance.Web.Controllers.AttendanceController.CheckOutSearchRow>();
}
<h1 class="h4 mb-3">Registrar Salida</h1>
@if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success">@successMessage</div> }
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger">@errorMessage</div> }

<div class="card shadow-sm">
    <div class="card-body">
        <form id="checkout-form" asp-action="@(ViewBag.FormAction as string ?? "CheckOut")" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <label asp-for="RecordIds" class="form-label">Niños a retirar</label>
            <select asp-for="RecordIds" id="RecordIds" class="form-select form-select-lg mb-3" multiple size="8">
                @foreach (var row in activeRows)
                {
                    <option value="@row.RecordId" data-child-id="@row.ChildId">@row.ChildName - @row.GuardianName - @row.GuardianPhone @(string.IsNullOrWhiteSpace(row.TokenNumber) ? "" : $" - Ficha: {row.TokenNumber}")</option>
                }
            </select>
            <span asp-validation-for="RecordIds" class="text-danger small"></span>

            <label asp-for="CheckOutGuardianId" class="form-label">Padre que retira</label>
            <select asp-for="CheckOutGuardianId" id="CheckOutGuardianId" class="form-select form-select-lg mb-3">
                <option value="">Seleccioná padre</option>
            </select>
            <span asp-validation-for="CheckOutGuardianId" class="text-danger small"></span>

            <div class="border rounded p-2 mb-2 bg-white">
                <label class="form-label mb-1">Firma salida (opcional)</label>
                <canvas id="checkout-signature-pad" class="w-100" height="140"></canvas>
                <input asp-for="CheckOutSignatureBase64" type="hidden" id="CheckOutSignatureBase64" />
                <div class="mt-2 d-flex gap-2">
                    <button type="button" id="btn-clear-checkout-signature" class="btn btn-outline-secondary btn-sm">Limpiar firma</button>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Registrar salida</button>
        </form>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@5.0.4/dist/signature_pad.umd.min.js"></script>
    <script src="~/js/signature-helper.js" asp-append-version="true"></script>
    <script src="~/js/attendance-checkout.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
