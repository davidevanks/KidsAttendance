@model KidsAttendance.Web.ViewModels.CheckInViewModel
@{
    ViewData["Title"] = "Registrar Entrada";
    var groups = ViewBag.Groups as IReadOnlyList<KidsAttendance.Infrastructure.Persistence.Entities.ClassGroup> ?? new List<KidsAttendance.Infrastructure.Persistence.Entities.ClassGroup>();
    var teacherFixedGroup = ViewBag.TeacherFixedGroup as KidsAttendance.Infrastructure.Persistence.Entities.ClassGroup;
    var checkInBlocked = (ViewBag.CheckInBlocked as bool?) == true;
    var checkInBlockedMessage = ViewBag.CheckInBlockedMessage as string;
    var registerUrl = teacherFixedGroup != null
        ? Url.Action("Create", "Children", new { myGroupOnly = true })
        : Url.Action("Create", "Children");
}
<h1 class="h4 mb-3">Registrar Entrada</h1>
@if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success">@successMessage</div> }
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger">@errorMessage</div> }
@if (checkInBlocked)
{
    <div class="alert alert-warning">@checkInBlockedMessage</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form id="checkin-form"
              asp-action="@(ViewBag.FormAction as string ?? "CheckIn")"
              method="post"
              data-hide-phone="@(User.IsInRole(ApplicationRoles.Teacher).ToString().ToLowerInvariant())"
              data-is-global="@(((ViewBag.IsGlobalAttendance as bool?) == true).ToString().ToLowerInvariant())">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger small mb-2"></div>
            @if (teacherFixedGroup is not null)
            {
                <label class="form-label">Grupo asignado</label>
                <input type="text" class="form-control form-control-lg mb-2" value="@teacherFixedGroup.Name" readonly />
                <input asp-for="ClassGroupId" type="hidden" value="@teacherFixedGroup.Id" />
            }
            else
            {
                <label asp-for="ClassGroupId" class="form-label">Grupo</label>
                <select asp-for="ClassGroupId" id="ClassGroupId" class="form-select form-select-lg mb-2">
                    <option value="">Seleccioná un grupo</option>
                    @foreach (var g in groups) { <option value="@g.Id">@g.Name</option> }
                </select>
                <span asp-validation-for="ClassGroupId" class="text-danger small"></span>
            }

            <label asp-for="ChildIds" class="form-label mt-2">Niños (buscar por nombre)</label>
            <select asp-for="ChildIds" id="ChildIds" class="form-select form-select-lg mb-1" multiple></select>
            <span asp-validation-for="ChildIds" class="text-danger small"></span>
            <div class="small text-muted mb-3">
                ¿El niño no está registrado?
                <a href="@registerUrl" class="fw-semibold">Registrar nuevo niño</a>
            </div>

            <label asp-for="GuardianId" class="form-label">Quién entrega</label>
            <select asp-for="GuardianId" id="GuardianId" class="form-select form-select-lg mb-1">
                <option value="">Seleccioná quién entrega...</option>
            </select>
            <span asp-validation-for="GuardianId" class="text-danger small"></span>

            <div id="no-guardian-found" class="d-none mb-3 mt-2">
                <div class="small text-muted mb-2">¿La persona que entrega no está en la lista?</div>
                <button id="btn-show-quick-guardian" type="button" class="btn btn-outline-secondary btn-sm">Agregar padre / tutor nuevo</button>
            </div>

            <div id="quick-guardian-panel" class="border rounded p-3 mb-3 mt-2 d-none">
                <div class="small fw-semibold mb-2">Registrar quién entrega</div>
                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <input id="quick-guardian-name" class="form-control" placeholder="Nombre completo" />
                    </div>
                    <div class="col-12 col-md-4">
                        <input id="quick-guardian-phone" class="form-control" inputmode="numeric" placeholder="Celular (solo números)" />
                    </div>
                    <div class="col-12 col-md-2">
                        <button id="btn-quick-save-guardian" type="button" class="btn btn-primary w-100">Guardar</button>
                    </div>
                </div>
                <div id="quick-guardian-msg" class="small mt-2"></div>
            </div>

            <label asp-for="TokenNumber" class="form-label mt-1">Ficha</label>
            <input asp-for="TokenNumber" id="TokenNumber" class="form-control form-control-lg mb-1" placeholder="Se aplicará a todos los niños seleccionados" />
            <div class="form-text mb-2">Si registrás varios hijos en este ingreso, todos usarán esta misma ficha.</div>
            <span asp-validation-for="TokenNumber" class="text-danger small"></span>

            <div class="border rounded p-2 mb-2 bg-white mt-2">
                <label class="form-label mb-1">Firma entrada</label>
                <canvas id="checkin-signature-pad" class="w-100" height="140"></canvas>
                <input asp-for="CheckInSignatureBase64" type="hidden" id="CheckInSignatureBase64" />
                <div class="mt-2 d-flex gap-2">
                    <button type="button" id="btn-clear-checkin-signature" class="btn btn-outline-warning btn-sm">Limpiar firma</button>
                </div>
                <div id="checkin-signature-error" class="text-danger small mt-1 d-none">La firma de entrada es requerida.</div>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100" @(checkInBlocked ? "disabled" : null)>Registrar</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signature_pad/signature_pad.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/signature-helper.js" asp-append-version="true"></script>
    <script src="~/js/attendance-checkin.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
}
