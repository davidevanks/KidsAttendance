@model KidsAttendance.Web.ViewModels.TeacherAssignmentViewModel
@{
    ViewData["Title"] = "Asignación de Maestros a Grupos";
    var allTeachers = ViewBag.AllTeachers as IReadOnlyList<KidsAttendance.Infrastructure.Persistence.Entities.AppUser> ?? new List<KidsAttendance.Infrastructure.Persistence.Entities.AppUser>();
    var availableTeachers = ViewBag.AvailableTeachers as IReadOnlyList<KidsAttendance.Infrastructure.Persistence.Entities.AppUser> ?? new List<KidsAttendance.Infrastructure.Persistence.Entities.AppUser>();
    var groups = ViewBag.Groups as IReadOnlyList<KidsAttendance.Infrastructure.Persistence.Entities.ClassGroup> ?? new List<KidsAttendance.Infrastructure.Persistence.Entities.ClassGroup>();
    var assignments = ViewBag.Assignments as IReadOnlyList<KidsAttendance.Infrastructure.Persistence.Entities.TeacherClassGroup> ?? new List<KidsAttendance.Infrastructure.Persistence.Entities.TeacherClassGroup>();
}

<h1 class="h4 mb-3">Asignación de Maestros a Grupos</h1>
@if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success">@successMessage</div> }
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger">@errorMessage</div> }

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form asp-action="Assign" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-12 col-md-5">
                <select asp-for="TeacherUserId" class="form-select form-select-lg js-teacher-select" data-placeholder="Buscar maestro por nombre...">
                    <option value=""></option>
                    @foreach (var teacher in availableTeachers)
                    {
                        <option value="@teacher.Id">@teacher.FullName (@teacher.Email)</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-5">
                <select asp-for="ClassGroupId" class="form-select form-select-lg">
                    <option value="">Seleccionar grupo</option>
                    @foreach (var group in groups)
                    {
                        <option value="@group.Id">@group.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary btn-lg w-100">Asignar</button>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="js-datatable table table-striped align-middle">
        <thead><tr><th data-priority="1">Maestro</th><th data-priority="1">Grupo</th><th data-priority="3">Desde</th><th data-priority="1" class="text-end">Acciones</th></tr></thead>
        <tbody>
        @foreach (var item in assignments)
        {
            var teacher = allTeachers.FirstOrDefault(x => x.Id == item.TeacherUserId);
            var group = groups.FirstOrDefault(x => x.Id == item.ClassGroupId);
            <tr>
                <td>@(teacher?.FullName ?? item.TeacherUserId)</td>
                <td>@(group?.Name ?? $"Grupo #{item.ClassGroupId}")</td>
                <td>@item.AssignedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td class="text-end">
                    <form asp-action="Deactivate" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Desactivar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <script>
        $(function () {
            var $teacherSelect = $(".js-teacher-select");
            if ($teacherSelect.length === 0 || !$.fn.select2) {
                return;
            }

            $teacherSelect.select2({
                theme: "bootstrap-5",
                width: "100%",
                placeholder: $teacherSelect.data("placeholder") || "Buscar maestro...",
                allowClear: true
            });
        });
    </script>
}
