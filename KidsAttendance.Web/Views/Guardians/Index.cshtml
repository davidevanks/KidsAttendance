@model IReadOnlyList<KidsAttendance.Infrastructure.Persistence.Entities.Guardian>
@{
    ViewData["Title"] = "Padres";
    var teacherNoGroup = (ViewBag.TeacherNoGroup as bool?) == true;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Padres</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo padre</a>
</div>
@if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success">@successMessage</div> }
@if (teacherNoGroup) { <div class="alert alert-warning">No tenés grupo activo asignado.</div> }
<div class="table-responsive">
    <table class="js-datatable table table-striped align-middle">
        <thead><tr><th data-priority="1">Nombre</th><th data-priority="1">Celular</th><th data-priority="3">Secundario</th><th data-priority="4">Estado</th><th data-priority="1" class="text-end">Editar</th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.PhoneNumber</td>
                <td>@item.SecondaryPhoneNumber</td>
                <td><span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">@(item.IsActive ? "Activo" : "Inactivo")</span></td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Editar</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
